{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": [
    "apps/api/src/**/*.ts",
    "modules/identity/src/**/*.ts",
    "modules/tenant/src/**/*.ts",
    "modules/organization/src/**/*.ts",
    "modules/rbac/src/**/*.ts",
    "modules/masters/src/**/*.ts",
    "modules/tour-planning/src/**/*.ts",
    "modules/tour-approval/src/**/*.ts",
    "modules/tour-execution/src/**/*.ts",
    "modules/tour-progress/src/**/*.ts",
    "modules/visit-execution/src/**/*.ts",
    "modules/doctor-call/src/**/*.ts",
    "modules/inventory/src/**/*.ts"
  ]
}
