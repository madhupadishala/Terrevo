{
  "name": "terrevo",
  "version": "0.20.0",
  "private": true,
  "description": "Terrevo field-force automation platform",
  "type": "module",
  "scripts": {
    "verify:foundation": "node scripts/verify-foundation.mjs",
    "build:api": "node -e \"require('fs').rmSync('.vercel-api',{recursive:true,force:true})\" && tsc -p tsconfig.vercel-api.json",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "verify:vercel-runtime": "node scripts/verify-vercel-runtime.mjs",
    "build": "npm run build:api && npm run build:web && npm run verify:vercel-runtime",
    "typecheck:web": "tsc -p apps/web/tsconfig.json",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck:web",
    "test": "node --experimental-strip-types --test apps/api/test/*.test.ts",
    "verify": "npm run verify:foundation && npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "5.8.3",
    "vite": "^7.0.0"
  }
}
