    "expo-location": "~57.0.19",
    "expo-secure-store": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "5.8.3"
  }
}
